{
  "info": {
    "name": "Red de Bicicletas - autenticación y API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login correcto - devuelve JWT",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login correcto',()=>pm.response.to.have.status(200));",
              "pm.environment.set('token',pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"demo@bicicletas.com\", \"password\": \"Bicicletas123!\"}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "Login incorrecto - 401 esperado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"demo@bicicletas.com\", \"password\": \"incorrecta\"}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "Listar bicicletas con JWT",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/bicicletas"
      }
    },
    {
      "name": "Listar bicicletas sin JWT - 401 esperado",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/bicicletas"
      }
    },
    {
      "name": "Crear bicicleta con JWT",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"marca\": \"Specialized\", \"modelo\": \"Rockhopper\", \"tipo\": \"Montaña\", \"precio\": 22000, \"disponible\": true, \"ubicacion\": \"Tegucigalpa\"}"
        },
        "url": "{{baseUrl}}/api/bicicletas"
      }
    }
  ]
}